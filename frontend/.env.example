# Example env for the frontend (Vite)
# Copy to .env.development or .env.production as needed.

# Base URL of the backend (no trailing slash). In development you can leave blank
# to use the Vite proxy (which defaults to http://localhost:8000), or set it to
# a full URL for production builds.
# Examples:
# VITE_API_BASE=http://localhost:8000/api
# VITE_API_BASE=https://api.example.com/api
VITE_API_BASE=
