# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# IMPORTANTE: todo origen https/http que use el frontend en producción DEBE
# estar aquí. Si falta el dominio, POST /api/login/ (y todo POST) falla con
# 403 "Origin checking failed" (incidente 2026-10-26).
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=fgpy_sessionid
CSRF_COOKIE_NAME=fgpy_csrftoken

# Producción (ejemplo para dashboard.forestalparaguay.com detrás de Traefik):
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=dashboard.forestalparaguay.com
# CSRF_TRUSTED_ORIGINS=https://dashboard.forestalparaguay.com
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_SECURE_SSL_REDIRECT queda en False a propósito: Traefik ya redirige
# http->https; activarlo en Django causaría loops de redirección.

# Database: SQLite for local development
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email: console backend prevents real delivery in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=demo@example.invalid
EMAIL_HOST_PASSWORD=replace-with-an-app-password
DEFAULT_FROM_EMAIL=Dashboard FGPY <no-reply@example.invalid>
DAILY_REPORT_EMAIL_TO=recipient@example.invalid

# Frontend development proxy
BACKEND_URL=http://localhost:8000
VITE_API_BASE=
